<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  This file is the app's real Info.plist: INFOPLIST_FILE points at it and
	  GENERATE_INFOPLIST_FILE is NO, so what you read here is what ships.
	  Do not reintroduce INFOPLIST_KEY_* build settings — they are ignored when
	  generation is off, which is exactly how this bundle previously lost its
	  usage-description strings.

	  $(…) tokens are substituted from build settings at package time, so
	  versions stay bumpable in one place (the .pbxproj / agvtool / CI).
	-->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>WriteBetter</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<!--
	  Menu-bar-only utility: no Dock tile, no app menu. Declaring it here means
	  the app is born as an accessory. Doing it at runtime with
	  NSApp.setActivationPolicy(.accessory) leaves a visible Dock-icon flash.
	-->
	<key>LSUIElement</key>
	<true/>

	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Ashish Jain. Released under the MIT licence.</string>

	<!--
	  Sparkle 2 auto-update. The feed is a release asset, so
	  releases/latest/download/appcast.xml always points at the newest
	  non-prerelease. The public key verifies the EdDSA signature that
	  release.yml puts on each DMG; its private half lives only in the
	  maintainer's keychain and the SPARKLE_ED_PRIVATE_KEY repo secret.
	  Automatic checks are on by default and can be turned off in About.
	-->
	<key>SUFeedURL</key>
	<string>https://github.com/Ashishjain608/write-better/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>X4auol1WgUT/mKvw1iHkYZcQq8uIBbhsgZE3c4taur0=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>

	<!--
	  Text capture is clipboard-first: WriteBetter reads whatever you last
	  copied and needs no permission at all for that. Accessibility is a
	  strictly optional upgrade that unlocks two things — reading the current
	  selection without you pressing ⌘C, and pasting the result back in place.
	-->
	<key>NSAccessibilityUsageDescription</key>
	<string>WriteBetter can read the text you have selected in another app and paste the improved version straight back into it. This is optional — without it, WriteBetter works from whatever you copy with ⌘C.</string>
</dict>
</plist>
