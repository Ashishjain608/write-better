<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Options for `xcodebuild -exportArchive`.

	  The normal release path is ./create-dmg.sh, which builds and signs
	  directly and does not archive. This file exists for the archive-based
	  route (Xcode Organizer, or a CI job that wants an .xcarchive to keep).

	  It only works once a Developer ID Application certificate is installed;
	  with no identity, `-exportArchive` fails and create-dmg.sh's ad-hoc path
	  is the thing to use instead.

	  When you have a team, add:
	      <key>teamID</key><string>YOURTEAMID</string>
	  and set `destination` to `upload` if you want Xcode to submit the archive
	  for notarization as part of the export.
	-->
	<key>method</key>
	<string>developer-id</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Hardened runtime is already on in the project; keep the archive honest. -->
	<key>stripSwiftSymbols</key>
	<true/>
	<key>uploadSymbols</key>
	<false/>
</dict>
</plist>
